# Names only: never commit real values. Values are added as each step needs them (docs/ROADMAP.md).
# Web (apps/web): copy to apps/web/.env.local. Mobile (Step 4): apps/mobile/.env.
# Local values: `pnpm exec supabase status -o env` (API_URL, PUBLISHABLE_KEY) and the local
# bizcost_api password from supabase/seed.sql.

# Supabase (custom domain in prod — never hard-code *.supabase.co in client builds)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile's public site key: sign-up, codes, password sign-in and resets ask it for a token
# (D-352). Empty locally, where Auth asks for none. Hosted: set it before db-migrate turns CAPTCHA on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server only
# Same Supabase URL for server-only contexts (CI, scripts) where the NEXT_PUBLIC_ name is not set.
SUPABASE_URL=
# Auth admin API (account deletion) and Storage signed URLs (business logo). Required in production;
# locally from `supabase status` (SECRET_KEY).
SUPABASE_SECRET_KEY=
# Postgres as the API role bizcost_api (never postgres/service_role).
# Local stack (password set by supabase/seed.sql, local only):
# DATABASE_URL=postgresql://bizcost_api:bizcost_local_dev@127.0.0.1:54322/postgres
DATABASE_URL=
# Hosted only: the database's CA certificate (PEM; public, not a secret), from Supabase → Database →
# Settings → SSL Configuration. Without it the API refuses a hosted database (D-362). Empty locally.
DATABASE_CA_CERT=
# Oldest mobile app version (x-app-version, semver) the API still serves. Default 0.0.0.
MIN_SUPPORTED_APP_VERSION=
# Comma-separated origins allowed to send cookie-authenticated mutations, e.g. https://app.example.com.
# Required in production; defaults to http://localhost:3000,http://127.0.0.1:3000 in development.
APP_ORIGINS=
# The web app's origin for links in emails (invitations), e.g. https://app.example.com.
# Required in production; defaults to the first APP_ORIGINS entry (http://localhost:3000) in development.
APP_URL=
# The API's own emails (invitations; Auth codes are sent by Supabase Auth). One transport is required in
# production. Local: EMAIL_TRANSPORT=smtp sends to the stack's Mailpit (SMTP_HOST 127.0.0.1, SMTP_PORT
# 54325 by default; supabase/config.toml [local_smtp] smtp_port). Production: RESEND_API_KEY + EMAIL_FROM.
EMAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=
RESEND_API_KEY=
# Sender, e.g. BizCost <notify@example.com>. Required with RESEND_API_KEY.
EMAIL_FROM=
# Dev-only (D-125): planned modules whose build has started, to try on a local server before their
# release, as a comma-separated list of module ids (a released module is ignored, D-188). Read only
# when NODE_ENV is development or test; production builds (next build/start, Vercel) ignore it.
BIZCOST_PREVIEW_MODULES=
# The closed beta. Released modules this deployment holds back, as a comma-separated list of module ids
# (D-359): the gates, the nav and the pages treat them as not yet built. Read in production too; an
# unknown name stops the server. Hosted: invoices, until the tax agent's review (D-350).
BIZCOST_HELD_MODULES=
# Comma-separated addresses of the platform admins: who may open the owner's beta page /platform
# (D-357). Empty: nobody.
BIZCOST_PLATFORM_ADMINS=
# Where "Send feedback" is emailed (D-356). Empty: feedback is only saved, on the beta page.
BIZCOST_FEEDBACK_EMAIL=
# Hosted, only if a PDF fails and the function log or Sentry says "the PDF service folder (worker.mjs) was
# not found": the absolute path of that folder in the deployment (beta-launch.md, part 2). Empty: it is
# looked for from the working directory.
BIZCOST_PDF_DIR=
# Server-side error reporting (read by apps/web/instrumentation.ts only); Sentry stays off when empty.
SENTRY_DSN=
