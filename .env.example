# Names only: never commit real values. Values are added as each step needs them (docs/ROADMAP.md).
# Web (apps/web): copy to apps/web/.env.local. Mobile (Step 4): apps/mobile/.env.
# Local values: `pnpm exec supabase status -o env` (API_URL, PUBLISHABLE_KEY) and the local
# bizcost_api password from supabase/seed.sql.

# Supabase (custom domain in prod — never hard-code *.supabase.co in client builds)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only
# Same Supabase URL for server-only contexts (CI, scripts) where the NEXT_PUBLIC_ name is not set.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Postgres as the API role bizcost_api (never postgres/service_role).
# Local stack (password set by supabase/seed.sql, local only):
# DATABASE_URL=postgresql://bizcost_api:bizcost_local_dev@127.0.0.1:54322/postgres
DATABASE_URL=
# Oldest mobile app version (x-app-version, semver) the API still serves. Default 0.0.0.
MIN_SUPPORTED_APP_VERSION=
# Comma-separated origins allowed to send cookie-authenticated mutations, e.g. https://app.example.com.
# Required in production; defaults to http://localhost:3000,http://127.0.0.1:3000 in development.
APP_ORIGINS=
# Server-side error reporting (read by apps/web/instrumentation.ts only); Sentry stays off when empty.
SENTRY_DSN=
