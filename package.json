{
  "name": "bizcost",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db && pnpm --filter @bizcost/db test:db",
    "api:test": "pnpm --filter @bizcost/api test:api",
    "e2e": "pnpm --filter @bizcost/e2e e2e",
    "demo:seed": "pnpm --filter @bizcost/api demo:seed",
    "demo:reset": "pnpm --filter @bizcost/api demo:reset",
    "dev:clean-test-data": "pnpm --filter @bizcost/api dev:clean-test-data",
    "auth:signing-key": "node -e \"const fs=require('node:fs');const f='supabase/signing_keys.json';if(fs.existsSync(f)){console.error(f+' already exists (delete it to rotate the local key)');process.exit(1)}fs.writeFileSync(f,'[]')\" && supabase gen signing-key --algorithm ES256 --yes",
    "docker:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-docker.ps1"
  },
  "devDependencies": {
    "@bizcost/config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "supabase": "2.117.0",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
