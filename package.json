{
  "name": "bizcost",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db && pnpm --filter @bizcost/db test:db",
    "api:test": "pnpm --filter @bizcost/api test:api",
    "auth:signing-key": "node -e \"const fs=require('node:fs');const f='supabase/signing_keys.json';if(fs.existsSync(f)){console.error(f+' already exists (delete it to rotate the local key)');process.exit(1)}fs.writeFileSync(f,'[]')\" && supabase gen signing-key --algorithm ES256 --yes"
  },
  "devDependencies": {
    "@bizcost/config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "supabase": "2.117.0",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
